# ============================================================
#  Fieldwork — environment variables
#  Copy to ".env.local" and fill in. Never commit .env.local.
# ============================================================

# Deployed Fieldwork contract on Testnet Bradbury.
# Leave empty to run the site on seed records (nothing is sent on submit).
NEXT_PUBLIC_FIELDWORK_CONTRACT=

# --- Content addressed storage ---
# Photographs must be content addressed, otherwise the leader and the
# validators can end up grading different bytes. Get a JWT from
# https://app.pinata.cloud (API Keys -> New Key).
PINATA_JWT=

# Gateway used to build the url handed to the contract. Must be a host the
# contract's ALLOWED_HOSTS list accepts.
CAS_GATEWAY=https://gateway.pinata.cloud
